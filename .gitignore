__pycache__/
*.pyc
.openclaw/

# Local environment variables — never commit this
.env

# LLM call logs (distillation data — large, never committed)
logs/

# Runtime data files (generated at runtime, not committed)
market_research.json
auto_trades.json
last_telegram_message.txt
telegram_daily_summary.txt

# Paper trading state files (runtime data, never committed)
paper_trading_state*.json
manifold_bot/paper_trading_state.json
*.bak

# Memory logs (local session notes, not committed)
memory/

# Calibration database (SQLite binary — generated at runtime, never committed)
data/*.db

# Root-level script copies (stale duplicates — canonical copies are in automation/)
/auto_research.py
/auto_trader.py
/daily_summary.py
/send_telegram.py
/setup_cron_jobs.py
/test_automation.py
/AUTOMATION_README.md
/cron_jobs_config.json

# OpenClaw regenerates this file from its own cron state on every sync.
# The OS crontab (via automation/setup_cron_jobs.py) is the authoritative scheduler.
automation/cron_jobs_config.json

# Generated reports and PDFs
*.pdf
*.tex

# Diagnostic scripts (temporary debugging tools)
/check_*.py
/fix_*.py
/quick_*.py
/lookup_*.py
/resolve_*.py
/trading_cycle_status.py
/market_mapping.json

# ClawHub-installed skills (installed by `openclaw skills install`, not part of our source)
skills/healthcheck/

# Runtime state files (generated, not source)
pending_swaps.json
auto_trades.json
market_research.json
data/ai_timeout_cooldown.json

# OpenClaw system files
.clawhub/

# Backup files
automation/auto_research_backup.py

# MCP server config (contains absolute local paths, not portable)
.mcp.json
